iddle" font-size="12" style="fill:var(--color-text)">2010</text><text x="543.3938531800991" y="429" text-anchor="middle" font-size="10" style="fill:var(--color-muted)">age 20</text></g><g><line x1="666.0307715344588" x2="666.0307715344588" y1="40" y2="396" style="stroke:var(--graph-grid);stroke-width:1"></line><text x="666.0307715344588" y="414" text-anchor="middle" font-size="12" style="fill:var(--color-text)">2015</text><text x="666.0307715344588" y="429" text-anchor="middle" font-size="10" style="fill:var(--color-muted)">age 25</text></g><g><line x1="788.6676898888185" x2="788.6676898888185" y1="40" y2="396" style="stroke:var(--graph-grid);stroke-width:1"></line><text x="788.6676898888185" y="414" text-anchor="middle" font-size="12" style="fill:var(--color-text)">2020</text><text x="788.6676898888185" y="429" text-anchor="middle" font-size="10" style="fill:var(--color-muted)">age 30</text></g><g><line x1="911.3046082431781" x2="911.3046082431781" y1="40" y2="396" style="stroke:var(--graph-grid);stroke-width:1"></line><text x="911.3046082431781" y="414" text-anchor="middle" font-size="12" style="fill:var(--color-text)">2025</text><text x="911.3046082431781" y="429" text-anchor="middle" font-size="10" style="fill:var(--color-muted)">age 35</text></g><g><line x1="60" x2="970" y1="396" y2="396" style="stroke:var(--graph-grid);stroke-width:1"></line><text x="52" y="400" text-anchor="end" font-size="12" style="fill:var(--color-muted)">-5</text></g><g><line x1="60" x2="970" y1="218" y2="218" style="stroke:var(--graph-axis);stroke-width:1.5"></line><text x="52" y="222" text-anchor="end" font-size="12" style="fill:var(--color-muted)">0</text></g><g><line x1="60" x2="970" y1="40" y2="40" style="stroke:var(--graph-grid);stroke-width:1"></line><text x="52" y="44" text-anchor="end" font-size="12" style="fill:var(--color-muted)">+5</text></g><text x="0" y="0" transform="translate(16 129) rotate(-90)" text-anchor="middle" font-size="11" style="fill:var(--color-muted)">Highs</text><text x="0" y="0" transform="translate(16 307) rotate(-90)" text-anchor="middle" font-size="11" style="fill:var(--color-muted)">Lows</text><line x1="629.239696028151" x2="727.3492307116386" y1="146.8" y2="146.8" style="stroke:var(--color-positive);stroke-width:6;stroke-linecap:round;opacity:0.35"></line><path d="M60.0,218.0 L138.7,111.2 L285.9,360.4 L506.6,75.6 L604.7,396.0 L629.2,146.8" stroke="url(#lifeline-line-gradient)" style="fill:none;stroke-width:2.5;stroke-linejoin:round"></path><circle cx="60" cy="218" r="4" style="fill:transparent;stroke:var(--color-positive);stroke-width:2"></circle><g class="graph-event"><title>Little sister was born</title><g><circle cx="143.19202261071226" cy="111.19999999999999" r="3.5" style="fill:var(--color-positive);stroke:transparent;stroke-width:1.5"></circle><circle cx="140.08259908539952" cy="115.47975432332818" r="3.5" style="fill:var(--color-positive);stroke:transparent;stroke-width:1.5"></circle><circle cx="135.051446136025" cy="113.84503363531611" r="3.5" style="fill:var(--color-positive);stroke:transparent;stroke-width:1.5"></circle><circle cx="135.051446136025" cy="108.55496636468386" r="3.5" style="fill:var(--color-positive);stroke:transparent;stroke-width:1.5"></circle><circle cx="140.08259908539952" cy="106.9202456766718" r="3.5" style="fill:var(--color-positive);stroke:transparent;stroke-width:1.5"></circle><circle cx="138.69202261071226" cy="111.19999999999999" r="2.5" style="fill:transparent"></circle></g><text x="138.69202261071226" y="97.19999999999999" text-anchor="middle" font-size="11" style="fill:var(--color-text)">Little sister was born</text></g><g class="graph-event"><title>Parents divorced</title><path d="M278.8563246359439,363.4 L281.8563246359439,355.4 L289.8563246359439,354.4 L292.8563246359439,361.4 L288.8563246359439,366.4 L281.8563246359439,366.4 Z" style="fill:var(--color-negative);stroke:transparent;stroke-width:1.5"></path><text x="285.8563246359439" y="332.4" text-anchor="middle" font-size="11" style="fill:var(--color-text)">Parents divorced</text></g><g class="graph-event"><title>Moved to Madrid</title><circle cx="506.60277767379125" cy="75.59999999999997" r="11" style="fill:none;stroke:var(--graph-turning-point);stroke-width:2.5"></circle><circle cx="506.60277767379125" cy="75.59999999999997" r="6" style="fill:var(--color-positive);stroke:transparent;stroke-width:1.5"></circle><text x="506.60277767379125" y="61.599999999999966" text-anchor="middle" font-size="11" style="fill:var(--color-text)">Moved to Madrid</text></g><g class="graph-event"><title>Grandmother passed away</title><g><rect x="601.7123123572791" y="393" width="6" height="10" style="fill:var(--color-negative);stroke:transparent;stroke-width:1.5"></rect><path d="M604.7123123572791,385 Q607.7123123572791,390 604.7123123572791,392 Q601.7123123572791,390 604.7123123572791,385 Z" style="fill:var(--color-negative);stroke:transparent;stroke-width:1.5"></path></g><text x="604.7123123572791" y="368" text-anchor="middle" font-size="11" style="fill:var(--color-text)">Grandmother passed away</text></g><g class="graph-event"><title>First job</title><circle cx="629.239696028151" cy="146.8" r="6" style="fill:var(--color-positive);stroke:transparent;stroke-width:1.5"></circle><text x="629.239696028151" y="132.8" text-anchor="middle" font-size="11" style="fill:var(--color-text)">First job</text></g></svg>"`;
